# Provider credentials. Copy to .env and fill in — .env is gitignored.
#
# Every variable here is read in exactly one place, lib/adapters/config.ts, and a test
# checks this file against that list so the two cannot drift.
#
# A missing required key fails at adapter construction with a message naming the variable,
# rather than as a 401 halfway through a paid scan.

# --- required ---------------------------------------------------------------

# Google Places API (New). Business listings, and the gbp collector.
# Billed per call by field mask tier — see PROFILE_FIELDS in lib/adapters/places.ts before
# widening what is asked for.
GOOGLE_PLACES_API_KEY=

# DataForSEO. Map pack positions for localrank, and the full review history for reviews.
# The review history is what makes REVIEW_VELOCITY_LOW reachable in cold mode — see
# docs/data-sources.md.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Anthropic. The narrative writer, and Claude in the aivis prompt set.
ANTHROPIC_API_KEY=

# --- optional ---------------------------------------------------------------

# PageSpeed Insights works without a key but is rate-limited hard. On a scan fanning out
# over six targets, unkeyed PSI will refuse partway through — sitetech degrades rather than
# failing, but the vitals half of the section goes missing.
PAGESPEED_API_KEY=

# The other two models in the aivis prompt set. A prompt set naming a model with no key
# fails loudly rather than quietly reporting a thinner citation share.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Places region, if not the UK default.
PLACES_REGION_CODE=

# --- speed-to-lead identity -------------------------------------------------
#
# NOT NEEDED YET. Sending enquiries is deferred (docs/teardown-engine.md §4), and the
# read-only probe that runs instead contacts nobody, so these four can stay empty. They are
# here so the shape is settled before anyone wires up a sender.
#
# Read before filling these in: docs/teardown-engine.md §4, and CLAUDE.md.
#
# The speedtolead collector contacts real businesses. The enquiry must be genuine and
# identified — a real question from a named person on an inbox we monitor. These four
# fields are that identity, and lib/collectors/speedtolead/ethics.ts refuses anything
# anonymous, unattributable, or that books work which does not exist.
#
# STL_REPLY_TO must be an inbox that is actually monitored: it is where the reply lands and
# how the response time is measured. STL_PHONE must be a real number we answer.

STL_FROM_NAME=
STL_REPLY_TO=
STL_PHONE=
STL_DISCLOSURE=
